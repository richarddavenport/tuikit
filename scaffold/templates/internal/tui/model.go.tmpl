// Package tui is <<.Name>>'s interface.
package tui

import (
	"strings"

	tea "github.com/charmbracelet/bubbletea"

	"github.com/richarddavenport/tuikit/app"
	"github.com/richarddavenport/tuikit/comp"

	"<<.Module>>/internal/engine"
)

// Model is <<.Name>>'s whole state, and it is a POINTER.
//
// tuikit's components own state — where a cursor is, what a viewport shows,
// where a divider sits — and state inside a component cannot survive being
// copied on every message. A value model compiles, runs, and silently forgets
// every scroll. It is the one change the first migration onto tuikit had to
// make in every file, so it is what a new tool starts with.
type Model struct {
	snap engine.Snapshot
	sty  styles

	// The components own what would otherwise be fields here, and the
	// arithmetic that keeps them honest.
	list  comp.List
	split comp.Split
	mouse app.Mouse
	gen   app.Gen

	// filter narrows the list. typing is the mode split: while it is true, j
	// is the letter j and not a movement. app.Keys makes that the shape of the
	// routing rather than an early return somebody can delete.
	filter string
	typing bool

	err error

	width, height int

	// canvas is the last frame, kept so a click can ask what it landed on. The
	// frame IS the region list, so there is nothing else to keep in step.
	canvas *comp.Canvas
}

// New builds the model.
func New() *Model {
	m := &Model{width: 132, height: 38, sty: newStyles(Palette)}
	m.list = comp.List{
		Name:       regItemsRow,
		Empty:      "  nothing matches",
		Marker:     "> ",
		Blank:      "  ",
		Selected:   &m.sty.selected,
		Unfocused:  &m.sty.focused,
		Status:     &m.sty.muted,
		EmptyStyle: &m.sty.muted,
	}
	m.split = comp.Split{Name: regSplit, Ratio: [2]int{1, 3}, Min: 24}
	return m
}

// SetSize is what a test calls instead of waiting for a terminal.
func (m *Model) SetSize(w, h int) { m.width, m.height = w, h }

// Canvas is the last frame, so a capture script can address a region by name.
func (m *Model) Canvas() *comp.Canvas { return m.canvas }

// Load puts a snapshot in, for a fixture that has one already.
func (m *Model) Load(s engine.Snapshot) { m.snap = s }

// visible is the items the filter admits, and the list every index refers to.
func (m *Model) visible() []engine.Item {
	if m.filter == "" {
		return m.snap.Items
	}
	var out []engine.Item
	for _, i := range m.snap.Items {
		if matches(i, m.filter) {
			out = append(out, i)
		}
	}
	return out
}

func matches(i engine.Item, filter string) bool {
	f := strings.ToLower(filter)
	return strings.Contains(strings.ToLower(i.Name), f) ||
		strings.Contains(strings.ToLower(i.Group), f)
}

// selected is the item under the cursor, and whether there is one.
//
// Two return values rather than an index, because a filter that matches
// nothing is an ordinary state: every caller handles the empty case instead of
// indexing into it.
func (m *Model) selected() (engine.Item, bool) {
	list := m.visible()
	if len(list) == 0 {
		return engine.Item{}, false
	}
	if c := m.list.Cursor(); c < len(list) {
		return list[c], true
	}
	return list[len(list)-1], true
}

// snapshotMsg carries a read of the world back, with the generation it belongs
// to.
type snapshotMsg struct {
	gen  int
	snap engine.Snapshot
	err  error
}

// Init starts the first read of the world.
func (m *Model) Init() tea.Cmd { return m.fetch() }

// fetch reads the world.
//
// app.Gen drops a result from a read the user walked away from. The bug it
// prevents is nasty because nothing errors: a stale result draws into the
// screen that replaced it, and nothing says why.
func (m *Model) fetch() tea.Cmd {
	gen := m.gen.Current()
	return func() tea.Msg {
		snap, err := engine.Fetch()
		return snapshotMsg{gen: gen, snap: snap, err: err}
	}
}

// Update handles one message.
func (m *Model) Update(msg tea.Msg) (app.Model, tea.Cmd) {
	switch msg := msg.(type) {
	case tea.WindowSizeMsg:
		m.width, m.height = msg.Width, msg.Height

	case snapshotMsg:
		if m.gen.Stale(msg.gen) {
			return m, nil
		}
		m.snap, m.err = msg.snap, msg.err

	case tea.MouseMsg:
		return m, m.onMouse(msg)

	case tea.KeyMsg:
		return m, m.key(msg)
	}
	return m, nil
}

// key routes one keystroke, and the ORDER is the contract.
//
// Whatever is capturing gets the key first, then the screen, then the globals.
// A global handled before the filter box is a filter box you cannot type q
// into. app.Keys makes that order the shape of a struct rather than a comment.
func (m *Model) key(msg tea.KeyMsg) tea.Cmd {
	return app.Keys{
		Capture: m.capture(),
		Screen:  m.screenKey,
		Global:  m.globalKey,
	}.Route(msg)
}

// capture is whatever is eating keystrokes, or nil. A nil Capture is a tool
// with nothing capturing, rather than a tool that forgot to say.
func (m *Model) capture() app.Handled {
	if !m.typing {
		return nil
	}
	return m.filterKey
}

func (m *Model) screenKey(msg tea.KeyMsg) (tea.Cmd, bool) {
	switch msg.String() {
	case "j", "down":
		m.list.Move(1)
	case "k", "up":
		m.list.Move(-1)
	case "/":
		m.typing = true
	case "r":
		// A new generation, so anything still in flight lands in the void.
		m.gen.Next()
		return m.fetch(), true
	default:
		return nil, false
	}
	return nil, true
}

func (m *Model) globalKey(msg tea.KeyMsg) (tea.Cmd, bool) {
	switch msg.String() {
	case "q", "ctrl+c":
		return tea.Quit, true
	}
	return nil, false
}

func (m *Model) filterKey(msg tea.KeyMsg) (tea.Cmd, bool) {
	switch msg.String() {
	case "enter":
		m.typing = false
	case "esc":
		m.typing, m.filter = false, ""
		m.list.Reset()
	case "backspace":
		if m.filter != "" {
			m.filter = m.filter[:len(m.filter)-1]
			m.list.Reset()
		}
	default:
		if len(msg.Runes) == 1 {
			m.filter += string(msg.Runes)
			// The rows changed under the cursor, so it goes back to the top
			// rather than pointing at whatever moved into its place.
			m.list.Reset()
		}
	}
	return nil, true
}

// onMouse routes a mouse event against the last frame.
//
// app.Mouse holds the one piece of state that matters: a drag owns the mouse
// until release, whatever it is now over. The pointer outruns the divider on
// every real drag, and without that rule the divider is dropped mid-gesture.
func (m *Model) onMouse(msg tea.MouseMsg) tea.Cmd {
	return m.mouse.Route(msg, m.canvas, app.Handler{
		Press: func(id comp.ID, _ tea.MouseMsg) tea.Cmd {
			if id.Name == regItemsRow {
				m.list.Select(id.Index)
			}
			return nil
		},
		// The wheel moves the VIEWPORT of whatever the pointer is over, never
		// the selection. Wiring it to the cursor makes scrolling appear to
		// pick items at random.
		Wheel: func(id comp.ID, by int) tea.Cmd {
			if id.Name == regItems || id.Name == regItemsRow {
				m.list.Scroll(by)
			}
			return nil
		},
		Drags: func(id comp.ID) bool { return id.Name == regSplit },
		Drag: func(_ comp.ID, msg tea.MouseMsg) tea.Cmd {
			m.split.MoveTo(msg.X, m.body())
			return nil
		},
	})
}

// Run opens <<.Name>>'s interface. The model is passed in rather than built
// here, because the caller may want to capture it instead of showing it.
func Run(m *Model) error {
	// The runner owns the canvas, its size, its chrome and its pixel layer.
	// comp.Detect asks the terminal what it can draw beyond characters; on one
	// that can only draw characters it costs one query and changes nothing.
	p := tea.NewProgram(
		app.New(m, app.WithChrome(Chrome), app.WithPixels(comp.Detect())),
		tea.WithAltScreen(), tea.WithMouseCellMotion())
	_, err := p.Run()
	return err
}
