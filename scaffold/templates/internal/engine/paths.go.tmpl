package engine

import (
	"os"
	"path/filepath"
)

// Where <<.Name>> keeps its files, and why it is not os.UserConfigDir().
//
// tuikit decision 33. The standard library's UserConfigDir honours
// $XDG_CONFIG_HOME on Linux and ignores it on macOS, where it answers
// ~/Library/Application Support — right for an application with a bundle
// identifier, wrong for a command-line tool. A developer's ~/.config holds gh,
// git, nvim, tmux and sops, and it is the directory people symlink into a
// dotfiles repository. A config you cannot carry to the next machine is a
// config you will write twice.
//
// This file is COPIED into every tool rather than imported from tuikit: config
// is engine work, and guard.Engine denies the engine every tuikit import
// (decision 22). Owning these lines beats a layering rule with an exception in
// it. Change them freely — they are yours.

// EnvConfig and EnvState name explicit locations, checked before the defaults.
// An empty value is treated as unset, so `<<.Env>>_CONFIG= <<.Name>>` does not
// silently look in the current directory.
const (
	EnvConfig = "<<.Env>>_CONFIG"
	EnvState  = "<<.Env>>_STATE_DIR"
)

// ConfigDir is $XDG_CONFIG_HOME/<<.Name>>, else ~/.config/<<.Name>>.
func ConfigDir() (string, error) { return under("XDG_CONFIG_HOME", ".config") }

// StateDir is $XDG_STATE_HOME/<<.Name>>, else ~/.local/state/<<.Name>>.
//
// Separate from ConfigDir on purpose. Config is written by a person and belongs
// in that dotfiles repository; state is written by <<.Name>> and must not follow
// anyone to another machine, because it records what is true about THIS one.
func StateDir() (string, error) {
	if dir := os.Getenv(EnvState); dir != "" {
		return dir, nil
	}
	return under("XDG_STATE_HOME", ".local", "state")
}

// Exts are the extensions tried at each location, in order.
//
// Two, not seven. dive reaches this list through viper and accepts yaml, json,
// toml, hcl, ini and properties; a tool that reads one format should not answer
// questions about the other five. `.yml` is here because leaving it out is a
// support question forever.
var Exts = []string{"yaml", "yml"}

// ConfigPaths is every location searched, most specific first.
//
// tuikit decision 33, and the order is dive's, read from `anchore/fangs` on
// 2026-09-08 rather than from its README:
//
//	./<<.Name>>.yaml            a config that belongs to this checkout
//	./.<<.Name>>.yaml           the same thing, hidden
//	~/.<<.Name>>.yaml           the classic single-file dotfile
//	$XDG_CONFIG_HOME/<<.Name>>/config.yaml   or ~/.config/<<.Name>>/ when unset
//	$XDG_CONFIG_DIRS/<<.Name>>/config.yaml   each entry, system-wide, last
//
// FIRST MATCH WINS. dive merges every file it finds, which is right for a
// scanner run under a fleet-wide policy and wrong here: once files merge, "which
// config am I using" stops having an answer and becomes "which key came from
// where". A tool a person runs on their own machine should be able to answer the
// first question in one line.
//
// $XDG_CONFIG_DIRS is last because it is the system-wide half of the spec — an
// administrator's default, which anything the person wrote themselves outranks.
//
// The whole list is returned rather than just the winner, because the only
// useful thing to say when nothing is found is WHERE it looked. "no config
// found" sends a reader off to guess; the list sends them to create one.
func ConfigPaths(explicit string) []string {
	if explicit == "" {
		explicit = os.Getenv(EnvConfig)
	}
	if explicit != "" {
		// An explicitly named config is the answer, present or not. Falling
		// back would hide the fact that the path was wrong — and nothing
		// system-wide may override what a person typed on the command line.
		return []string{explicit}
	}

	var paths []string
	add := func(dir, base string) {
		for _, ext := range Exts {
			paths = append(paths, filepath.Join(dir, base+"."+ext))
		}
	}

	add(".", "<<.Name>>")
	add(".", ".<<.Name>>")
	if home, err := os.UserHomeDir(); err == nil {
		add(home, ".<<.Name>>")
	}
	if dir, err := ConfigDir(); err == nil {
		add(dir, "config")
	}
	for _, dir := range systemConfigDirs() {
		add(dir, "config")
	}
	return paths
}

// systemConfigDirs is $XDG_CONFIG_DIRS split, each with <<.Name>> appended.
//
// Colon-separated and ordered, like $PATH. The spec's default is /etc/xdg, and
// it is used when the variable is unset OR empty — an empty value means "the
// default", not "nowhere", which is the opposite of how $<<.Env>>_CONFIG is
// treated above and is worth the two lines to get right.
//
// Relative entries are dropped for the same reason ConfigDir drops them: a
// relative config directory resolves against wherever <<.Name>> was started.
func systemConfigDirs() []string {
	raw := os.Getenv("XDG_CONFIG_DIRS")
	if raw == "" {
		raw = "/etc/xdg"
	}
	var out []string
	for _, dir := range filepath.SplitList(raw) {
		if filepath.IsAbs(dir) {
			out = append(out, filepath.Join(dir, "<<.Name>>"))
		}
	}
	return out
}

// FindConfig returns the first path that exists, and every path it tried. The
// tried list is returned on success too, so a caller can say which one won.
func FindConfig(explicit string) (path string, tried []string, ok bool) {
	tried = ConfigPaths(explicit)
	for _, p := range tried {
		if fi, err := os.Stat(p); err == nil && !fi.IsDir() {
			return p, tried, true
		}
	}
	return "", tried, false
}

// under resolves one XDG variable, falling back to a path under the home
// directory. The variable wins only when it is absolute: XDG says a relative
// value is invalid and must be ignored, and honouring one would resolve the
// config against whatever directory <<.Name>> happened to start in.
func under(env string, fallback ...string) (string, error) {
	if dir := os.Getenv(env); filepath.IsAbs(dir) {
		return filepath.Join(dir, "<<.Name>>"), nil
	}
	home, err := os.UserHomeDir()
	if err != nil {
		return "", err
	}
	return filepath.Join(append([]string{home}, append(fallback, "<<.Name>>")...)...), nil
}
