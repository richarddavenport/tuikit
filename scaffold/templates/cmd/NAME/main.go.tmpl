// Command <<.Name>> <<.Short>>.
//
//	<<.Name>>                 open the interface
//	<<.Name>> list            the same thing, for a script
//	<<.Name>> describe --json the whole surface, in one call
package main

import (
	"fmt"
	"os"

	"github.com/richarddavenport/tuikit/spec"

	"<<.Module>>/internal/cli"
	"<<.Module>>/internal/tui"
)

// version is stamped by the linker. See the Makefile.
var version = "dev"

// main decides when the process ends.
//
// Nothing in spec calls os.Exit, which is why this is not cobra: the exit-code
// contract is richer than ok-or-not — 2 means a dry run found DRIFT, a finding
// rather than a failure — and a framework that owns the exit is a framework
// that flattens it. Run returns a code; this function spends it.
//
// The dual-mode entry lives here too, because main is the only place that
// knows a bare `<<.Name>>` means "show me": no arguments opens the interface,
// anything else is a command.
func main() {
	root := cli.Commands()
	argv := os.Args[1:]
	if len(argv) == 0 {
		argv = []string{"browse"}
	}

	switch argv[0] {
	case "version":
		fmt.Println(version)
		os.Exit(spec.OK)

	case "describe":
		// The whole surface in one call, so an agent never has to grep for it:
		// the commands, their flags, the palette and the glyph set.
		out, err := spec.Describe(root, version, tui.Palette, tui.Glyphs).JSON()
		if err != nil {
			fmt.Fprintln(os.Stderr, "<<.Name>>:", err)
			os.Exit(spec.Fail)
		}
		fmt.Println(string(out))
		os.Exit(spec.OK)

	case "completion":
		if len(argv) < 2 {
			fmt.Fprintln(os.Stderr, "usage: <<.Name>> completion <bash|zsh|fish>")
			os.Exit(spec.Fail)
		}
		if err := spec.CompletionScript(argv[1], "<<.Name>>", os.Stdout); err != nil {
			fmt.Fprintln(os.Stderr, "<<.Name>>:", err)
			os.Exit(spec.Fail)
		}
		os.Exit(spec.OK)

	case "__complete":
		// What the shell calls back into. The scripts know nothing about the
		// commands, so they cannot go stale when one is added.
		for _, word := range spec.Complete(root, argv[1:]) {
			fmt.Println(word)
		}
		os.Exit(spec.OK)
	}

	os.Exit(spec.Run(root, argv, os.Stdout, os.Stderr))
}
